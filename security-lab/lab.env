# Pinned sources for the lab. The evm and cometbft versions are derived from
# node/go.mod by setup.sh unless overridden here.
NODE_REPO="https://github.com/xrplevm/node"
NODE_REF="main"
EVM_REPO="https://github.com/xrplevm/evm"
EVM_REF=""       # empty = version pinned by node/go.mod replace
COMETBFT_REPO="https://github.com/cometbft/cometbft"
COMETBFT_REF=""  # empty = version pinned by node/go.mod

# The only chain the lab may ever talk to.
LAB_CHAIN_ID="xrplevm_1449999-1"
LAB_EVM_CHAIN_ID="1449999"
NUM_VALIDATORS=4

# Real networks. Any tool in the lab refuses to run against these.
# Source: app/upgrades/v112/constants.go in xrplevm/node.
DENY_CHAIN_IDS="xrplevm_1440000-1 xrplevm_1449000-1 xrplevm_1449900-1"
DENY_EVM_CHAIN_IDS="1440000 1449000 1449900"
